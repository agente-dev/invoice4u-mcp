# Invoice4U MCP by Agente — environment configuration
# Copy to your MCP client's env block. Never commit real tokens.

# Required. Invoice4U API key. Never passed as a tool argument.
INVOICE4U_API_TOKEN=

# Required. Explicit environment selection: "qa" or "production".
# There is no default — the server refuses to start without this.
INVOICE4U_ENV=qa

# Optional, defaults to false. When false, the receipt-creation tool is not
# registered at all (absent from tools/list). Set to true only when you
# deliberately want write access.
INVOICE4U_ALLOW_WRITES=false

# Optional, defaults to info. debug logs redacted request/response metadata
# (never tokens or full customer payloads).
INVOICE4U_LOG_LEVEL=info
